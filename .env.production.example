# Copiar a `.env` en el VPS y completar. Ese archivo NO se versiona.

# Hace que `docker compose` use este archivo por defecto (evita levantar por error el compose de desarrollo).
COMPOSE_FILE=docker-compose.prod.yaml

# IP pública del VPS (sin http:// ni puerto). Se usa para CORS y para compilar el frontend.
PUBLIC_HOST=203.0.113.10

# Neon: connection string DIRECTA (host sin "-pooler"), con sslmode=require.
DATABASE_URL=postgresql://USUARIO:CLAVE@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require

# Archivos: Cloudflare R2 (bucket + API token con permiso "Object Read & Write" limitado a ese bucket).
S3_BUCKET=student-manager-files
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# S3_REGION=auto
# S3_FORCE_PATH_STYLE=false

# Login. JWT_SECRET: `openssl rand -base64 48`. Si ya tienes una profesora en Neon, pon aquí su email
# (si no, se crea una segunda sin años académicos). El seed reescribe la contraseña en cada despliegue.
JWT_SECRET=
ADMIN_NAME=Profesora
ADMIN_EMAIL=profesora@ejemplo.com
ADMIN_PASSWORD=cambia-esta-clave-larga

# Opcionales
# JWT_EXPIRES_IN=7d
# FRONTEND_DIST=./frontend-dist

# Solo si usas MinIO en vez de R2 (`docker compose --profile minio up -d`; ver DEPLOY.md)
# MINIO_ROOT_USER=
# MINIO_ROOT_PASSWORD=
