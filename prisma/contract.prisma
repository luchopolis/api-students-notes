// use prisma-8

enum GradeStatus {
  PENDING
  SUBMITTED
  GRADING
}

enum EvaluationType {
  NOTE_1
  NOTE_2
  EXAM
}

enum Gender {
  F
  M
}

model Teacher {
  id    Uuid   @id @default(uuid())
  name  String
  email String @unique

  academicYears AcademicYear[]

  @@map("teachers")
}

model AcademicYear {
  id         Uuid       @id @default(uuid())
  yearName   String     @unique // "2024-A", "2025-B"
  startDate  DateString
  endDate    DateString
  teacherId  Uuid

  teacher     Teacher      @relation(fields: [teacherId], references: [id])
  periods     Period[]
  enrollments Enrollment[]

  @@map("academic_years")
}

model Period {
  id             Uuid         @id @default(uuid())
  academicYearId Uuid
  number         Int          
  name           String
  evaluations    Evaluation[]

  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  files          PeriodFile[]

  @@unique([academicYearId, number])
  @@map("periods")
}


model PeriodFile {
  id          Uuid            @id @default(uuid())
  periodId    Uuid
  subjectId   Uuid
  fileName    String
  storageKey  String          @unique // key S3
  generatedAt TimestamptzString(3) @default(now())

  period      Period          @relation(fields: [periodId], references: [id])
  subject     Subject         @relation(fields: [subjectId], references: [id])

  @@index([periodId, subjectId, generatedAt])
  @@map("period_files")
}

model Student {
  id          Uuid         @id @default(uuid())
  dni         String       @unique
  firstName   String
  lastName1   String
  lastName2   String?
  gender      Gender?
  birthDate   DateString
  email       String       @unique

  enrollments Enrollment[]

  @@map("students")
}

model Subject {
  id          Uuid         @id @default(uuid())
  code        String       @unique // "MATE-01", "HIST-02"
  name        String
  description String?

  enrollments Enrollment[]
  activities  Activity[]
  periodFiles PeriodFile[]

  @@index([code])
  @@map("subjects")
}

model Enrollment {
  id               Uuid         @id @default(uuid())
  studentId        Uuid
  subjectId        Uuid
  academicYearId   Uuid
  registrationDate DateString

  student          Student      @relation(fields: [studentId], references: [id])
  subject          Subject      @relation(fields: [subjectId], references: [id])
  academicYear     AcademicYear @relation(fields: [academicYearId], references: [id])
  grades           Grade[]

  @@unique([studentId, subjectId, academicYearId])
  @@map("enrollments")
}

model Evaluation {
  id            Uuid           @id @default(uuid())
  periodId      Uuid
  type          EvaluationType
  weight        Float          @default(35.0) 
  activityOrder Int            @default(0) 

  period        Period         @relation(fields: [periodId], references: [id])
  activities    Activity[]

  @@unique([periodId, type])
  @@index([periodId, type])
  @@map("evaluations")
}

model Activity {
  id           Uuid       @id @default(uuid())
  evaluationId Uuid
  subjectId    Uuid
  name         String
  weight       Float      @default(100.0)
  description  String?

  evaluation   Evaluation   @relation(fields: [evaluationId], references: [id])
  subject      Subject      @relation(fields: [subjectId], references: [id])
  subActivities SubActivity[]
  grades       Grade[]

  @@unique([evaluationId, subjectId, name])
  @@index([evaluationId, subjectId])
  @@map("activities")
}

model SubActivity {
  id          Uuid    @id @default(uuid())
  activityId  Uuid
  name        String
  weight      Float
  description String?

  activity    Activity @relation(fields: [activityId], references: [id])
  grades      Grade[]

  @@unique([activityId, name])
  @@index([activityId])
  @@map("sub_activities")
}

model Grade {
  id             Uuid        @id @default(uuid())
  enrollmentId   Uuid
  activityId     Uuid?
  subActivityId  Uuid?
  gradeValue     Numeric(5, 2)
  submissionDate DateString?
  status         GradeStatus @default(PENDING)

  enrollment     Enrollment   @relation(fields: [enrollmentId], references: [id])
  activity       Activity?    @relation(fields: [activityId], references: [id])
  subActivity    SubActivity? @relation(fields: [subActivityId], references: [id])

  @@unique([enrollmentId, activityId])
  @@unique([enrollmentId, subActivityId])
  @@map("grades")
}
